<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Test Template</title>

  <!-- Favicon link -->
  <link rel="icon" href="./favicon.ico" type="image/x-icon">

  <!-- Link to Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900 font-sans">

  <!-- Main container for centering content -->
  <div class="container mx-auto p-4">
    <!-- Title Section -->
    <h1 class="text-3xl font-semibold text-center text-blue-600 mb-4">{{title}}</h1>  <!-- Dynamically replaced with data.title -->

    <!-- Description Section -->
    <p class="text-lg text-gray-700 mb-6">{{description}}</p>  <!-- Dynamically replaced with data.description -->

    <!-- Items List Section -->
    <h2 class="text-2xl font-bold text-gray-800 mb-3">Items List:</h2>
    <div class="bg-white p-4 rounded shadow-md">
      {{each items}}
        <p class="text-gray-800 py-2 border-b border-gray-300">
          <span class="font-semibold">{{name}}</span> - 
          <span class="text-green-600">${{price}}</span>
        </p>  <!-- Dynamically replaced with each item's name and price -->
      {{/each}}
    </div>

    <!-- Conditional Content Section -->
    {{if condition}}
      <p class="mt-4 text-white bg-blue-500 p-3 rounded text-center">
        This content is shown only if `condition` is true.
      </p>
    {{/if}}

  </div>
</body>
</html>
